#!/usr/bin/env python3
"""Fake `media-control get --micros --no-artwork`.

Mimics MediaRemote's single "elected" now-playing app: once the Spotify
harvest has played something, Spotify stays elected (even paused) until TIDAL
changes track, so the tool reports Spotify instead of TIDAL in that window.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _fakecommon import log, spotify_state, tidal  # noqa: E402

log("media-control", " ".join(sys.argv[1:]))
if sys.argv[1:2] != ["get"]:
    sys.exit(1)
st = tidal("/__state")
sp = spotify_state()
if st is None:
    print("null")
    sys.exit(0)
if sp.get("elected") and sp.get("elected_at_played") == st["playedCount"]:
    print(json.dumps({"processIdentifier": 999, "bundleIdentifier": "com.spotify.client", "playing": sp.get("playing", False),
                      "title": sp.get("title") or "Spotify", "artist": sp.get("artist") or "", "playbackRate": 1}))
    sys.exit(0)
t = st["track"]
if not t:
    print("null")
    sys.exit(0)
payload = {
    "processIdentifier": 4242, "bundleIdentifier": "com.tidal.desktop", "playing": st["playing"],
    "title": t["title"], "artist": t["artist"], "album": t.get("album", ""),
    "durationMicros": int(t["duration"] * 1e6), "elapsedTimeMicros": int(st["elapsed"] * 1e6),
    "timestampEpochMicros": int(st["nowMicros"]), "playbackRate": 1 if st["playing"] else 0,
}
print(json.dumps(payload))
